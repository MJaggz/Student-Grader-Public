<h2><%= resource_name.to_s.humanize %> Settings</h2>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>
<div class ="card">
<h3>Update Password</h3>
  <div class="form-group">
    <p>New <%= f.label :password %></p>
    <%= f.password_field :password, autocomplete: "new-password", class: "form-input"%>
    <% if @minimum_password_length %>
      <p><em><%= @minimum_password_length %> characters minimum</em></p>
    <% end %>
  </div>

  <div class="form-group">
    <p>New <%= f.label :password_confirmation %></p>
    <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-input"%>
  </div>

  <div class="form-group">
    <p><%= f.label :current_password %> </p>
    <%= f.password_field :current_password, autocomplete: "current-password", class: "form-input" %>
  </div>

  <div class="actions">
    <%= f.submit "Update" , class:"auth-btn"%>
  </div>
<% end %>
</div>

<div class="card">
<h3>Cancel Account</h3>
<p> This action cannot be undone.</p>
<div> <%= button_to "Cancel", registration_path(resource_name), data: { confirm: "Are you sure?", turbo_confirm: "Are you sure?" }, method: :delete, class: "back-link" %></div>
</div>
<%= link_to "Back", :back, class:"back-link" %>
