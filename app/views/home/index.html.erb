<%# Home Page %>
<% unless user_signed_in? %>
  <div class="card">
    <h1>CSE Course System At OSU</h1>
    <p>Welcome to the OSU CSE Department course and grader matching portal.</p>
  </div>
<% end %>

<hr>

<%# Display Login Status %>
<% if user_signed_in? %>
  <div class="card">
    <h3>Welcome, <%= current_user.email %>!</h3>
    <p>
      You are logged in as a
      <strong><%= current_user.role.capitalize %></strong>.
    </p>

<%# Available actions for logged in users %>
    <div class="actions">
      <%= link_to "Notifications", notifications_path, class: "button" %>
      <%= link_to "Settings", edit_user_registration_path, class: "button" %>
      <%= button_to "Logout",
            destroy_user_session_path,
            method: :delete,
            class: "button logout" %>
    </div>
  </div>

  <hr>
<% else %>
<%# Prompt to login when no user is signed in %>
  <div class="card">
    <h3>Get Started</h3>
    <p>Please log in or create an account to view available CSE courses.</p>

    <div class="auth-wrapper">
      <div class="auth-card">
        <div class="auth-card-content">
          <h1 class="auth-title">Log in</h1>
            <p class="auth-subtitle">Use your account to access the OSU CSE Course System.</p>

     
      <div class="form-group">
        <label class="form-label" for="email">Email</label>
        <input class="form-input" type="email" id="email" />
      </div>

      <div class="form-group">
        <label class="form-label" for="password">Password</label>
        <input class="form-input" type="password" id="password" />
      </div>

      <div class="remember-row">
        <input type="checkbox" id="remember" />
        <label for="remember">Remember me</label>
      </div>

      <%= link_to "Login", new_user_session_path, class: "auth-btn" %>

      <div class="auth-links">
        <a href="/users/sign_up">Sign up </a>
        <a href="/users/password/new">Forgot your password?</a>
      </div>
    </div>
  </div>
</div>
    </div>
  </div>
<% end %>

<%# Modules Avaailble for logged in Users %>
<% if user_signed_in? && defined?(users_path) %>
  <div class="card">
    <h3>Modules</h3>
    <p>
      You have access to the following services. If you need access to something additional,
      please apply for a different account type.
    </p>

    <div class="actions">
      <% if current_user.admin? %>
        <%= link_to "User Management", users_path, class: "button module" %>
        <%= link_to "Configure Course Catalog", configuration_courses_path, class: "button module" %>
        <%= link_to "View Course Catalog", courses_path, class: "button module" %>
        <%= link_to "View Grader Requests", grader_requests_path, class: "button module" %>
      <% elsif current_user.instructor? %>
        <%= link_to "View Courses/Request Grader", courses_path, class: "button module" %>
        <%= link_to "Recommend Student", new_recommendation_path, class: "button module" %>
      <% else %>
        <%= link_to "View Courses", courses_path, class: "button module" %>
        <%= link_to "Submit Grader Application", grader_application_path, class: "button module" %> 
        <%= link_to "My Assignments", assignments_list_path, class: "button module" %>
      <% end %>
          
    </div>
  </div>
<% end %>