<%# Admin Only - Course Catalog Syncing Page %>

<% if current_user.admin? %>
<div class="card">
  <div class="admin-reload-box">
    <h2>Sync Course Catalog</h2>
    
    <%= form_with url: reload_courses_path, method: :post, local: true do |f| %>
      <div class="form-grid">

      <div class= "cat-group">

        <%# Term Selection - Defaults to Spring 2026 %>
        <div>
          <%= f.label :term, "Academic Term", class:"cat-label"%>
          <%= f.select :term, [
            ["Autumn 2026", "1268"], ["Summer 2026", "1264"], ["Spring 2026", "1262"],
            ["Autumn 2025", "1258"], ["Summer 2025", "1254"], ["Spring 2025", "1252"],
            ["Autumn 2024", "1248"], ["Summer 2024", "1244"], ["Spring 2024", "1242"]
          ], { selected: "1262" }, class:"cat-input" %>
        </div>

        <%# Campus Selection - Defaults to Columbus %>
        <div class="cat-group">
          <%= f.label :campus, "Campus", class:"cat-label" %>
          <%= f.select :campus, [
            ["Columbus", "col"], ["Lima", "lma"], ["Mansfield", "mns"], 
            ["Marion", "mrn"], ["Newark", "nwk"], ["Wooster", "wst"]
          ], { selected: "col" }, class: "cat-input"%>
        </div>

        <%# Academic Career - Defaults to Undergraduate (UGRD) %>
        <div class= "cat-group">
          <%= f.label :"academic-career", "Academic Career" , class:"cat-label"%>
          <%= f.select :"academic-career", [
            ["Undergraduate", "ugrd"], ["Graduate", "grad"]
          ], { selected: "ugrd" }, class:"cat-input"%>
        </div>

        <%# Catalog Number - Defaults to 1xxx %>
        <div class= "cat-group">
          <%= f.label :"catalog-number", "Catalog Number", class:"cat-label" %>
          <%= f.select :"catalog-number", 
              ["1xxx", "2xxx", "3xxx", "4xxx", "5xxx", "6xxx", "7xxx", "8xxx"], 
              { selected: "1xxx" }, class:"cat-input" %>
        </div>

        <%# Instruction Mode - Defaults to In Person (P) %>
        <div class="cat-group">
          <%= f.label :"instruction-mode", "Instruction Mode", class:"cat-label" %>
          <%= f.select :"instruction-mode", [
            ["In Person", "p"], ["Distance Learning", "dl"], 
            ["Distance Enhanced", "dh"], ["Hybrid", "hy"]
          ], { selected: "p" }, class:"cat-input" %>
        </div>

      </div>

      <div class="form-actions">
        <%= f.submit "Update Local Database", class: "button submit-button" %>
      </div>
    <% end %>
  </div>
  </div>
<% end %>