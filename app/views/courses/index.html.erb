<%# Course Catalog - Allows Modifications for Admins %>
<h2>CSE Courses Catalog</h2>
<hr>

<%# Check for empty catalog %>
<% if @catalog_empty %>
<div class="card">
  <p>No courses available at the moment. </p>
  <p>Please contact an <i>administrator</i> for assistance.</p>

  <br/>
  <%= button_to "Get Courses From Api", configuration_courses_path,
                  method: :get,
                  form: { data: { turbo_confirm: "Are you sure you want to fetch courses from the API?" } },
                  class: "button" %>
</div>

<% else %>
<%# When catalog is not empty, display filters %>
  <div class="card">
    <h3> Filters </h3>

    <div class="actions">
      <%= form_with url: courses_path, method: :get, local: true, class: "filters" do %>
      <div>
        <%= label_tag :catalog_number, "Course Number" %><br>
        <%= select_tag :catalog_number,
              options_for_select([["All Course Numbers", ""]] + @course_number_levels.map { |level| [level, level] }, params[:catalog_number]) %>
      </div>

      <div>
        <%= label_tag :term, "Term" %><br>
        <%= select_tag :term,
              options_for_select([["All Terms", ""]] + @all_terms.map { |t| [t, t] }, params[:term]) %>
      </div>

      <div>
        <%= label_tag :campus, "Campus" %><br>
        <%= select_tag :campus,
              options_for_select([["All Campuses", ""]] + @all_campuses.map { |c| [c.upcase, c] }, params[:campus]) %>
      </div>

      <div>
        <%= label_tag :academic_career, "Career" %><br>
        <%= select_tag :academic_career,
              options_for_select([["All Careers", ""]] + @all_careers.map { |c| [c, c] }, params[:academic_career]) %>
      </div>

      <br>

      <%= submit_tag "Apply Filters", class: "button" %>
      <%= link_to "Clear Filters", courses_path, class: "button" %>
      <% end %>
    </div>
  </div>

  <%# Allow Admins to make changes to courses %>
  <% if current_user.admin? %>
  <div class="card">
    <h3> Tools</h3>

    <div class="actions">
      <%= button_to "Delete All Courses", destroy_all_courses_path,
                    method: :delete,
                    form: { data: { turbo_confirm: "Are you sure you want to wipe the entire catalog?" } },
                    class: "button danger" %>
      <%= button_to "Get More Courses", configuration_courses_path,
              method: :get,
              class: "button" %>
    </div>
  </div>
  <% end %>

  <%# Empty Catalog Notification%>
  <div class="card">
    <% if @courses.empty? %>
      <p>No courses found with that filter. Please try different filters.</p>
    <% else %>

      <%# Display the Catalog %>
      <table>
        <thead>
          <tr>
          
            <th>Subject</th>
            <th>Course Number</th>
            <th>Title</th>
            <th>Term</th>
            <th>Campus</th>
            <th>Career</th>
            <th>Sections</th>
            <% if current_user.admin? %>
              <th>Actions</th>
            
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% @courses.each do |course| %>
            <tr>
              <td><strong><%= course.subject %></strong></td>
              <td><%= course.catalog_number %></td>
              <td><%= course.title %></td>
              <td><%= course.term %></td>
              <td><%= course.campus.upcase if course.campus %></td>
              <td><small><%= course.academic_career %></small></td>
              <td>
                <%= link_to "View Sections", course_sections_path(course), class: "button info-button" %>
              </td>

              <% if current_user.admin? %>
                <td>
                  <%= button_to "Delete", course_path(course),
                                method: :delete,
                                form: { data: { turbo_confirm: "Delete this course?" } },
                                class: "button danger" %>
                </td>
                
<td>
  <%= link_to "Edit", edit_course_path(course), class: "button warning-button" %>
</td>
    
  </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
      <div class="pagination-container" style="display: flex; justify-content: center; padding: 1rem;">
        <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
      </div>
      
    <% end %>
  </div>
<% end %>
