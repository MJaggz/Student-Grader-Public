<h2>CSE Courses Catalog</h2>
<hr>

<div class="card">
<% if @courses.empty? %>
  <p>No courses available at the moment. </p>
  <p>Please contact an <i>adminstrator</i> for assistance.</p>

  <br/>
  <%= button_to "Fetch Courses From Api", fetch_courses_path,
                  method: :post,
                  form: { data: { turbo_confirm: "Are you sure you want to fetch courses from the API?" } },
                  class: "button danger" %> 

<% else %>
<h3> Filters </h3>

  <div class="actions">

<%= form_with url: courses_path, method: :get, local: true, class: "filters" do %>

      <div>
        <%= label_tag :catalog_number, "Course Number" %><br>
        <%= select_tag :subject,
              options_for_select([["All Course Numbers", ""]] + @all_course_numbers.map { |s| [s, s] }, params[:catalog_number]) %>
      </div>

      <div>
        <%= label_tag :term, "Term" %><br>
        <%= select_tag :term,
              options_for_select([["All Terms", ""]] + @all_terms.map { |t| [t, t] }, params[:term]) %>
      </div>

      <div>
        <%= label_tag :campus, "Campus" %><br>
        <%= select_tag :campus,
              options_for_select([["All Campuses", ""]] + @all_campuses.map { |c| [c.upcase, c] }, params[:campus]) %>
      </div>

      <div>
        <%= label_tag :academic_career, "Career" %><br>
        <%= select_tag :academic_career,
              options_for_select([["All Careers", ""]] + @all_careers.map { |c| [c, c] }, params[:academic_career]) %>
      </div>
    </div>

    <br>

    <%= submit_tag "Apply Filters", class: "button" %>
    <%= link_to "Clear Filters", courses_path, class: "button" %>
<% end %>
</div>
 <% if current_user.admin? %> 
<div class="card"> 
<h3> Tools</h3>

    <div class="actions">
      <%= button_to "Refresh Courses", update_courses_path,
                    method: :post,
                    form: { data: { turbo_confirm: "Fetch latest course data from the API and sync the catalog?" } },
                    class: "button" %>
      <%= button_to "Delete All Courses", destroy_all_courses_path,
                    method: :delete,
                    form: { data: { turbo_confirm: "Are you sure you want to wipe the entire catalog?" } },
                    class: "button danger" %>
    </div>
  
  <% end %>
  </div>

<div class="card">
  <table class="course-table">
    <thead>
      <tr>
        <th>Subject</th>
        <th>Course Number</th>
        <th>Title</th>
        <th>Term</th>
        <th>Campus</th>
        <th>Career</th>
        <% if current_user.admin? %><th>Actions</th><% end %>
      </tr>
    </thead>
    <tbody>
      <% @courses.each do |course| %>
        <tr>
          <td><strong><%= course.subject %></strong></td>
          <td><%= course.catalog_number %></td>
          <td><%= course.title %></td>
          <td><%= course.term %></td>
          <td><%= course.campus.upcase if course.campus %></td>
          <td><small><%= course.academic_career %></small></td>

          <% if current_user.admin? %>
            <td>
              <%= button_to "Delete", course_path(course),
                            method: :delete,
                            form: { data: { turbo_confirm: "Delete this course?" } },
                            class: "button danger" %>
            </td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
</div>
