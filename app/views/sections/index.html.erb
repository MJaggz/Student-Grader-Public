<%# Course Sections Page %>
<div class="card">
  <h2>Sections for <%= @course.subject %> <%= @course.catalog_number %></h2>
  <p><strong>Title:</strong> <%= @course.title %></p>
  <% if @selected_term.present? %>
    <p><strong>Showing term:</strong> <%= @selected_term %></p>
  <% end %>
  <%= link_to "← Back to Courses", courses_path(term: @selected_term.presence), class: "button secondary" %>
</div>

<div class="card">
  <% if @available_terms.present? %>
    <div class="actions">
      <%= form_with url: course_sections_path(@course), method: :get, local: true, class: "filters" do %>
        <div>
          <%= label_tag :term, "Manage Term" %><br>
          <%= select_tag :term,
                options_for_select([["All Terms", ""]] + @available_terms.map { |term| [term, term] }, @selected_term) %>
        </div>

        <br>

        <%= submit_tag "Apply Term Filter", class: "button" %>
        <%= link_to "Clear Filter", course_sections_path(@course), class: "button" %>
      <% end %>
    </div>
  <% end %>

  <% if @sections.empty? %>
    <p><%= @selected_term.present? ? "No sections found for this course in that term." : "No sections found for this course." %></p>
  <% else %>
    <table class="course-table">
      <thead>
        <tr>
          <th>Section</th>
          <th>Class #</th>
          <th>Term</th>
          <th>Days</th>
          <th>Times</th>
          <th>Location</th>
          <th>Credit Hours</th>
          <th>Instruction Mode</th>
          <th>Graders Required</th>
          <th>Grader Request</th>
          <% if current_user.admin? %>
            <th>Actions</th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% @sections.each do |section| %>
          <tr>
            <td><%= section.section_number %></td>
            <td><%= section.class_number %></td>
            <td><%= section.term %></td>
            <td><%= section.days %></td>
            <td><%= section.times %></td>
            <td><%= section.location %></td>
            <td><%= section.credit_hours %></td>
            <td><%= section.instruction_mode %></td>
            <td><%= section.graders_required %></td>
            <td>
              <% if section.grader_request.present? %>
                <span>Request already submitted</span>
              <% else %>
                <button type="button" onclick="document.getElementById('grader-request-modal-<%= section.id %>').showModal()">
                  Request Grader
                </button>
              <% end %>
            </td>
            <% if current_user.admin? %>
              <td>
                <%= link_to "Edit Section", edit_section_path(section), class: "button warning-button" %>
              </td>
            <% end %>
          </tr>

          <% unless section.grader_request.present? %>
            <dialog id="grader-request-modal-<%= section.id %>">
              <h3>Request grader for Section <%= section.section_number %></h3>
              <p>This request will use the section requirement of <strong><%= section.graders_required %></strong> grader(s).</p>

              <%= form_with model: [section, GraderRequest.new], url: section_grader_request_path(section), local: true do |f| %>
                <div>
                  <%= f.submit "Submit Request" %>
                  <button type="button" onclick="document.getElementById('grader-request-modal-<%= section.id %>').close()">
                    Cancel
                  </button>
                </div>
              <% end %>
            </dialog>
          <% end %>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
