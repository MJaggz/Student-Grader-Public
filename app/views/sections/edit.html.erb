<div class="card">
  <h2>Edit Section</h2>
  <p><strong>Course:</strong> <%= @section.course.subject %> <%= @section.course.catalog_number %></p>
  <p><strong>Section:</strong> <%= @section.section_number %></p>
  <p><strong>Term:</strong> <%= @section.term %></p>
</div>

<div class="card">
  <% if @section.errors.any? %>
    <div class="flash alert">
      <strong>Unable to save section:</strong>
      <%= @section.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <%= form_with model: @section, local: true do |f| %>
    <div class="cat-group">
      <%= f.label :days, "Days", class: "cat-label" %>
      <%= f.text_field :days, required: true, class: "cat-input" %>
    </div>

    <div class="cat-group">
      <%= f.label :times, "Times", class: "cat-label" %>
      <%= f.text_field :times, required: true, class: "cat-input" %>
    </div>

    <div class="cat-group">
      <%= f.label :location, "Location", class: "cat-label" %>
      <%= f.text_field :location, class: "cat-input" %>
    </div>

    <div class="cat-group">
      <%= f.label :instruction_mode, "Instruction Mode", class: "cat-label" %>
      <%= f.text_field :instruction_mode, class: "cat-input" %>
    </div>

    <div class="cat-group">
      <%= f.label :graders_required, "Graders Required", class: "cat-label" %>
      <%= f.number_field :graders_required, min: 1, required: true, class: "cat-input" %>
    </div>

    <div class="actions">
      <%= f.submit "Save Section", class: "button" %>
      <%= link_to "Back to Sections", course_sections_path(@section.course, term: @section.term), class: "button" %>
    </div>
  <% end %>
</div>
