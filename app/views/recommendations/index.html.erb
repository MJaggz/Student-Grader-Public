<h1>Recommendations From Instructors</h1>

<div class="card">
<% if @recommendations.any? %>
  <table border="1" cellpadding="8" cellspacing="0">
    <thead>
      <tr>
        <th>Recommended By</th>
        <th>Student Name</th>
        <th>Last Name.ID</th>
        <th>Course</th>
        <th>Section</th>
        <th>Created At</th>
        <th>Status</th>
      </tr>
    </thead>

    <tbody>
      <% @recommendations.each do |recommendation| %>
        <tr>
          <td><%= recommendation.recommended_by %></td>
          <td><%= recommendation.first_name + " " + recommendation.last_name %></td>
          <td><%= recommendation.last_name_id %></td>
          <td><%= recommendation.course %></td>
          <td><%= recommendation.section %></td>
          <td><%= recommendation.created_at.strftime("%B %d, %Y %I:%M %p") %></td>
          <td>
            <%= recommendation.status ? "Approved" : "Pending" %>
            <% if !recommendation.status %>
              <%= button_to "Approve", change_status_recommendation_path(recommendation), method: :patch, data: {
                turbo_confirm: "Are you sure you want to approve this recommendation?"
              }, class: "button module" %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No recommendations found.</p>
<% end %>
</div>