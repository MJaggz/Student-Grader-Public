<%# Catalog of Registered Users - Admin Only %>
<h2>All Registered Users</h2>
<div class="card">
<table>
  <thead>
    <tr>
      <th>Email (Name.#)</th>
      <th>Role</th>
      <th>Status</th>
      <th>Action</th>
    </tr>
  </thead>
  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= user.email %></td>
        <td><%= user.role.capitalize %></td>
        <% if current_user.admin? %>
        <% if user.approved? %>
          <td><span style="color: green;">Approved</span></td>
        <% else %>
          <td><%= button_to "Approve", approve_user_path(user), method: :patch, data: { turbo_confirm: "Are you sure?" }%></td>
        <% end %>
        <% if user != current_user %>
              <td><%= button_to "Delete User", user_path(user), method: :delete, data: { turbo_confirm: "Are you sure?" }%></td>
        <% end %>
        <% end %>
      </tr>
       
    <% end %>

  </tbody>
</table>
</div>
<%= link_to "Back", :back, class:"back-link" %>
