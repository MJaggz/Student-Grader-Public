<h1>All Registered Users</h1>

<table>
  <thead>
    <tr>
      <th>Email (Name.#)</th>
      <th>Role</th>
    </tr>
  </thead>
  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= user.email %></td>
        <td><%= user.role.capitalize %></td>
        <% if current_user.admin? %>
        <% if user.approved? %>
          <td><span style="color: green;">Approved</span></td>
        <% else %>
          <td><%= button_to "Approve", approve_user_path(user), method: :patch, data: { turbo_confirm: "Are you sure?" }%></td>
        <% end %>
        <% if user != current_user %>
        <% end %>
        <% end %>
      </tr>
          <td><%= button_to "Delete User", user_path(user), method: :delete, data: { turbo_confirm: "Are you sure?" }%></td>

    <% end %>

  </tbody>
</table>

