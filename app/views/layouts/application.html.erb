<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "Grader Manager" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%# Your CSS needs this .dashboard wrapper to make the Sidebar sit next to the Main area %>
    <div class="dashboard">
      
      <div class="sidebar">
        <h2>CSE Portal</h2>
        <% if user_signed_in? %>
          <div style="font-size: 0.75rem; color: #9ca3af; margin-bottom: 1.5rem;">
            <%= current_user.email %>
          </div>
        <% end %>

        <%= link_to "Dashboard", root_path %>

        <% if user_signed_in? %>
          <% if current_user.admin? %>
            <%= link_to "User Management", users_path %>
            <%= link_to "Course Catalog", courses_path %> 
          <% else %>
            <%= link_to "View Courses", courses_path %>
          <% end %>
          <%= link_to "Settings", edit_user_registration_path %>
        <% end %>

        <div class="actions" style="margin-top: 2rem;">
          <% if user_signed_in? %>
            <%= button_to "Logout", destroy_user_session_path, method: :delete, class: "button" %>
          <% else %>
            <%= link_to "Login", new_user_session_path, class: "button" %>
          <% end %>
        </div>
      </div>

      <div class="main">
        <div class="navbar">
          <div>Ohio State University CSE Course System</div>
        </div>

        <div class="content">
          
          <%# Flash Messages using your existing CSS classes %>
          <% if notice %>
            <div class="flash notice"><%= notice %></div>
          <% end %>

          <% if alert %>
            <div class="flash alert"><%= alert %></div>
          <% end %>

          <%= yield %>
        </div>
      </div>

    </div> <%# End of .dashboard %>
  </body>
</html>