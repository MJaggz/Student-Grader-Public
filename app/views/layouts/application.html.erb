<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "Grader Manager" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

 <!-- Begin Application Layout -->

  <body>
    <div class="dashboard">
      
      <div class="sidebar">
        <h2>CSE Portal</h2>
        <% if user_signed_in? %>
          <div style="font-size: 0.75rem; color: #9ca3af; margin-bottom: 1.5rem;">
            <%= current_user.email %>
          </div>
        <% end %>
        <!-- Sidebar Links -->
        <%= link_to "Dashboard", root_path %>

        <% if user_signed_in? %>
          <% if current_user.admin? %>
             <!-- Admin Only Links -->
            <%= link_to "User Management", users_path %>
            <%= link_to "Course Catalog", courses_path %> 
          
             <!-- Non-Admin Links -->
          <% else %>
            <%= link_to "View Courses", courses_path %>
          <% end %>
             <!-- Universal Links -->
          <%= link_to "Settings", edit_user_registration_path %>
        <% end %>

        <div class="actions" style="margin-top: 2rem;">
          <% if user_signed_in? %>
            
          <% end %>
        </div>
      </div>

     <!-- Top Bar -->
      <div class="main">
        <div class="navbar">
          <div>Ohio State University CSE Course System</div>
        </div>

        <div class="content">
        
<%= render "devise/shared/flash" %>

<!-- Page Content -->
          <%= yield %>
        </div>
      </div>

    </div>
  </body>
</html>